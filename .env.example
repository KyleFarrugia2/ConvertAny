# Copy to .env (Docker Compose) or backend/.env (local run). Never commit real secrets.

# --- required in production -------------------------------------------------
OC_SECRET_KEY=change-me-to-64-random-hex-chars   # python -c "import secrets;print(secrets.token_hex(32))"
POSTGRES_PASSWORD=change-me
OC_COOKIE_SECURE=true                             # set false only for plain-http local testing

# --- database (local runs default to SQLite in backend/data) ----------------
# OC_DATABASE_URL=postgresql+psycopg://omni:change-me@localhost:5432/omniconvert

# --- storage -----------------------------------------------------------------
OC_STORAGE_BACKEND=local          # local | s3
# OC_S3_BUCKET=omniconvert
# OC_S3_ENDPOINT_URL=http://minio:9000          # omit for AWS S3
# OC_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000 # endpoint browsers use for presigned URLs
# OC_S3_ACCESS_KEY_ID=
# OC_S3_SECRET_ACCESS_KEY=
# OC_S3_REGION=us-east-1

# --- retention & limits --------------------------------------------------------
OC_FILE_TTL_SECONDS=21600         # outputs & uploads auto-deleted after 6 h
OC_MAX_UPLOAD_BYTES=2147483648    # 2 GiB
OC_MAX_DURATION_SECONDS=10800     # 3 h
OC_MAX_GIF_SECONDS=30
OC_MAX_FILES_PER_BATCH=20
OC_MAX_URL_ITEMS_PER_BATCH=10
OC_MAX_ACTIVE_JOBS_PER_SESSION=25
OC_MAX_QUEUE_DEPTH=500
OC_JOB_TIMEOUT_SECONDS=10800

# --- enhancement limits -------------------------------------------------------
OC_ENABLE_120FPS=true
OC_INTERP_CPU_MAX_HEIGHT=1080
OC_INTERP_CPU_MAX_SECONDS_60=600
OC_INTERP_CPU_MAX_SECONDS_120=120
OC_INTERP_GPU_MAX_HEIGHT=2160
OC_INTERP_GPU_MAX_SECONDS_60=1800
OC_INTERP_GPU_MAX_SECONDS_120=600
OC_UPSCALE_AI_MAX_INPUT_HEIGHT=1080
OC_UPSCALE_AI_MAX_SECONDS=300
OC_PREVIEW_SECONDS=4

# --- optional GPU tools (paths to executables; models must sit next to them) --
# OC_RIFE_NCNN_PATH=C:\tools\rife-ncnn-vulkan\rife-ncnn-vulkan.exe
# OC_RIFE_MODEL=rife-v4.6
# OC_REALESRGAN_NCNN_PATH=C:\tools\realesrgan\realesrgan-ncnn-vulkan.exe

# --- workers ----------------------------------------------------------------------
OC_WORKER_QUEUES=cpu              # cpu, gpu or cpu,gpu
OC_WORKER_CONCURRENCY=2
OC_WORKER_MIN_FREE_DISK_BYTES=2147483648
OC_WORKER_MEMORY_LIMIT_BYTES=8589934592   # per media process; 4K encodes need ~2-4 GiB

# --- rate limits (per IP per minute) ---------------------------------------------
OC_RATE_ANALYZE_PER_MIN=20
OC_RATE_UPLOAD_PER_MIN=60
OC_RATE_JOBS_PER_MIN=40
# OC_TRUST_PROXY=1                # only behind a reverse proxy that sets X-Forwarded-For

# --- product ----------------------------------------------------------------------
OC_ABUSE_CONTACT_EMAIL=           # shown on the Report / Privacy pages when set
